# Names only; the real values live in qone-infra/.env (never versioned).
IDENTITY_DB_NAME=identity
IDENTITY_DB_USER=identity
IDENTITY_DB_PASSWORD=
# develop only: non-empty adds migrations/05_demo (the eight demo people) through flyway.develop.toml.
# Leave it empty in qa and main. The ADMIN is never seeded: qone-identity-api creates it on start.
IDENTITY_DB_DEMO_SEED=
# The demo accounts share one password in develop; the seed receives its hash as a Flyway
# placeholder: FLYWAY_PLACEHOLDERS_DEMO_PASSWORD_HASH=$(python scripts/hash-password.py "$DEMO_PASSWORD")
DEMO_PASSWORD=
FLYWAY_PLACEHOLDERS_DEMO_PASSWORD_HASH=
